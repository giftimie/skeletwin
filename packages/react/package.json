{
  "name": "@skeletwin/react",
  "version": "1.0.0",
  "description": "Skeletwin generates accessible React skeletons from your actual rendered layout.",
  "author": "giftimie",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-package-files.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "react",
    "skeleton",
    "loading",
    "placeholder",
    "typescript",
    "accessible"
  ]
}
