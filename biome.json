{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results",
      "!package-lock.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "cssModules": false } },
  "overrides": [
    {
      "includes": ["examples/playground/src/style.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    }
  ]
}
