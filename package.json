{
  "name": "skeletwin-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": "^22.23.0 || >=24.22.0"
  },
  "scripts": {
    "dev": "npm run dev -w @skeletwin/playground --",
    "build": "npm run build -w @skeletwin/react && npm run build -w @skeletwin/playground",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "node scripts/check-package.mjs",
    "pack": "npm pack --workspace @skeletwin/react",
    "publish:dry-run": "npm publish --workspace @skeletwin/react --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && npm run test:e2e && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "publint": "^0.3.8",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
